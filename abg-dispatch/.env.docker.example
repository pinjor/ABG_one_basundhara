# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
# Generate each secret separately:
#   openssl rand -base64 48   → JWT_SECRET
#   openssl rand -base64 32   → APP_ENCRYPTION_KEY, OTP_PEPPER
#   openssl rand -hex 24      → POSTGRES_PASSWORD

POSTGRES_PASSWORD=
JWT_SECRET=
APP_ENCRYPTION_KEY=
OTP_PEPPER=

# The browser origin of the admin portal, and the base URL printed in QR labels.
CORS_ORIGINS=http://localhost:18490
PUBLIC_QR_BASE_URL=http://localhost:18490

# Production defaults. For a throwaway demo stack you may set NODE_ENV=development
# and EXPOSE_DEV_OTP=true so guest/receipt codes appear on screen without an SMS gateway.
NODE_ENV=production
REQUIRE_ADMIN_MFA=true
EXPOSE_DEV_OTP=false

# SMS gateway: dev (log only) or http (POST JSON to SMS_HTTP_URL with SMS_API_KEY)
SMS_PROVIDER=dev
SMS_HTTP_URL=
SMS_API_KEY=
SMS_SENDER_ID=ABG

# Firebase Cloud Messaging (push). Service-account JSON on one line.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Courier webhook signing secrets (one per provider you enable)
PATHAO_WEBHOOK_SECRET=
REDX_WEBHOOK_SECRET=
STEADFAST_WEBHOOK_SECRET=
GENERIC_COURIER_WEBHOOK_SECRET=

# Host ports (change if they clash)
ADMIN_PORT=18490
API_PORT=18491
POSTGRES_PORT=18434

# Behind a TLS-inspecting proxy: its CA bundle, used only while building.
EXTRA_CA_FILE=

# Base images. Override to use a registry mirror, e.g. mirror.gcr.io/library/node:22-bookworm
NODE_BUILD_IMAGE=node:22-bookworm
NODE_RUNTIME_IMAGE=node:22-bookworm-slim
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_IMAGE=postgres:16-alpine
