# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://abg:abg_dev_password@localhost:18434/abg_dispatch?schema=public"
# 32+ random characters. `openssl rand -base64 48`
JWT_SECRET="change-me-to-a-long-random-string"
# 32 bytes, base64. Encrypts TOTP secrets at rest. `openssl rand -base64 32`
APP_ENCRYPTION_KEY=""
# Keyed hash for one-time codes. `openssl rand -base64 32`
OTP_PEPPER=""
# Admin portal origin(s), comma separated. Required in production.
CORS_ORIGINS="http://localhost:18490"

# ── Runtime ─────────────────────────────────────────────────────────────────
PORT=18491
NODE_ENV=development
# Base URL encoded in QR labels: <base>/q/<opaque token>
PUBLIC_QR_BASE_URL="https://dispatch.abg.com.bd"
# Private attachment storage (mount a volume here in Docker)
STORAGE_DIR="./storage"
# SLA engine cadence; 0 disables the scheduler
SLA_INTERVAL_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GUEST_SESSION_TTL_HOURS=12
# Require TOTP for branch/head-office admins, auditors and super admins
REQUIRE_ADMIN_MFA=false
# Development only: return one-time codes in API responses (no SMS gateway). Must be false in production.
EXPOSE_DEV_OTP=true

# ── Push notifications (Firebase Cloud Messaging HTTP v1) ───────────────────
FCM_PROJECT_ID=""
# Service-account JSON on one line
FCM_SERVICE_ACCOUNT_JSON=""

# ── SMS gateway ─────────────────────────────────────────────────────────────
# dev = record deliveries without sending; http = POST JSON to SMS_HTTP_URL
SMS_PROVIDER=dev
SMS_HTTP_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="ABG"

# ── Courier integrations (feature-flagged per provider in the admin portal) ─
PATHAO_WEBHOOK_SECRET=""
REDX_WEBHOOK_SECRET=""
STEADFAST_WEBHOOK_SECRET=""
GENERIC_COURIER_WEBHOOK_SECRET=""
PATHAO_API_TOKEN=""
REDX_API_TOKEN=""
STEADFAST_API_TOKEN=""
