// ABG Dispatch — chain-of-custody data model.
//
// `parcels` holds the present state of each dispatch. `parcel_events` holds what
// actually happened, in order, and is append-only (enforced by a trigger in the
// 0002 migration). Status values are validated against @abg-dispatch/shared and,
// as a second line of defence, by a transition trigger on `parcels`.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organisation ────────────────────────────────────────────────────────────

model Organization {
  id            String         @id @default(uuid())
  name          String
  code          String         @unique
  createdAt     DateTime       @default(now())
  businessUnits BusinessUnit[]
  branches      Branch[]

  @@map("organizations")
}

model BusinessUnit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String       @unique
  active         Boolean      @default(true)
  branches       Branch[]

  @@map("business_units")
}

model Branch {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  name           String
  /// Short code used in tracking numbers: ABG-261020-HO-00428
  code           String        @unique
  type           String
  address        String?
  city           String?
  phone          String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  locations      Location[]
  departments    Department[]
  employees      Employee[]
  userRoles      UserRole[]

  originParcels      Parcel[]         @relation("OriginBranch")
  destinationParcels Parcel[]         @relation("DestinationBranch")
  incidents          Incident[]
  tourRequests       TourRequest[]
  vehicles           Vehicle[]
  drivers            Driver[]
  carRequisitions    CarRequisition[]
  visits             Visit[]
  licences           Licence[]

  @@map("branches")
}

model Location {
  id        String     @id @default(uuid())
  branchId  String
  branch    Branch     @relation(fields: [branchId], references: [id])
  parentId  String?
  parent    Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children  Location[] @relation("LocationTree")
  type      String
  name      String
  code      String?
  /// Breadcrumb snapshot: "ABG Head Office › Level 7 › Legal Department"
  path      String
  latitude  Float?
  longitude Float?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  departments        Department[]
  employees          Employee[]
  originParcels      Parcel[]      @relation("OriginLocation")
  destinationParcels Parcel[]      @relation("DestinationLocation")
  incidents          Incident[]
  visits             Visit[]
  events             ParcelEvent[]

  @@index([branchId])
  @@map("locations")
}

model Department {
  id         String     @id @default(uuid())
  branchId   String
  branch     Branch     @relation(fields: [branchId], references: [id])
  name       String
  code       String
  /// Where parcels for this department are normally dropped.
  locationId String?
  location   Location?  @relation(fields: [locationId], references: [id])
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  employees  Employee[]

  senderParcels   Parcel[] @relation("SenderDepartment")
  receiverParcels Parcel[] @relation("ReceiverDepartment")

  @@unique([branchId, code])
  @@map("departments")
}

// ─── People ──────────────────────────────────────────────────────────────────

model Employee {
  id                String      @id @default(uuid())
  employeeCode      String      @unique
  fullName          String
  phone             String?
  email             String?
  designation       String?
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id])
  branchId          String
  branch            Branch      @relation(fields: [branchId], references: [id])
  defaultLocationId String?
  defaultLocation   Location?   @relation(fields: [defaultLocationId], references: [id])
  photoUrl          String?
  status            String      @default("ACTIVE")
  managerId         String?
  manager           Employee?   @relation("Manager", fields: [managerId], references: [id])
  reports           Employee[]  @relation("Manager")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User?

  sentParcels        Parcel[]            @relation("SenderEmployee")
  addressedParcels   Parcel[]            @relation("ReceiverEmployee")
  receivedParcels    Parcel[]            @relation("ActualReceiverEmployee")
  carrierAssignments CarrierAssignment[]

  @@index([fullName])
  @@index([phone])
  @@index([branchId])
  @@index([departmentId])
  @@map("employees")
}

model User {
  id               String    @id @default(uuid())
  email            String?   @unique
  employeeId       String?   @unique
  employee         Employee? @relation(fields: [employeeId], references: [id])
  displayName      String
  passwordHash     String
  active           Boolean   @default(true)
  locale           String    @default("en")
  /// TOTP secret, AES-256-GCM encrypted with APP_ENCRYPTION_KEY.
  mfaSecret        String?
  mfaEnabledAt     DateTime?
  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  roles             UserRole[]
  sessions          UserSession[]
  devices           DeviceToken[]
  notifications     Notification[]
  savedViews        SavedView[]
  preferences       NotificationPreference[]
  createdParcels    Parcel[]                 @relation("CreatedBy")
  reportedIncidents Incident[]               @relation("IncidentReporter")
  toursTravelled    TourRequest[]            @relation("TourTraveller")
  toursToApprove    TourRequest[]            @relation("TourApprover")
  carRequests       CarRequisition[]         @relation("CarRequester")
  carsToApprove     CarRequisition[]         @relation("CarApprover")
  driverProfile     Driver?                  @relation("DriverAccount")
  hostedVisits      Visit[]                  @relation("VisitHost")
  licencesOwned     Licence[]                @relation("LicenceOwner")
  noticesAuthored   Notice[]                 @relation("NoticeAuthor")
  noticeReceipts    NoticeReceipt[]          @relation("NoticeReader")
  assignmentsMade   CarrierAssignment[]      @relation("AssignedBy")

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  /// Branch scope for BRANCH_ADMIN / DISPATCH_OFFICER. Null = the employee's own branch.
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, role, branchId])
  @@map("user_roles")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  deviceName       String?
  platform         String?
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?

  @@index([userId])
  @@map("user_sessions")
}

/// A driver, messenger or temporary person who carries a parcel without an ABG account.
model GuestCarrier {
  id              String    @id @default(uuid())
  fullName        String
  phone           String
  company         String?
  idType          String?
  idReference     String?
  vehicleNumber   String?
  photoUrl        String?
  notes           String?
  phoneVerifiedAt DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  assignments CarrierAssignment[]
  sessions    GuestSession[]

  @@index([phone])
  @@map("guest_carriers")
}

/// A restricted, short-lived sign-in that can only act on the guest's own assignments.
model GuestSession {
  id             String       @id @default(uuid())
  guestCarrierId String
  guestCarrier   GuestCarrier @relation(fields: [guestCarrierId], references: [id])
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  ip             String?

  @@index([guestCarrierId])
  @@map("guest_sessions")
}

// ─── Reference data ──────────────────────────────────────────────────────────

model ParcelCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  parcels     Parcel[]

  @@map("parcel_categories")
}

model CourierProvider {
  id                  String    @id @default(uuid())
  code                String    @unique
  name                String
  enabled             Boolean   @default(true)
  /// Feature flag: call the provider's API. Off = manual tracking only.
  apiEnabled          Boolean   @default(false)
  webhookEnabled      Boolean   @default(false)
  trackingUrlTemplate String?
  /// Non-secret settings (base URL, store id). Secrets live in environment variables.
  config              Json      @default("{}")
  healthStatus        String    @default("UNKNOWN")
  healthMessage       String?
  healthCheckedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  assignments CarrierAssignment[]
  events      ExternalProviderEvent[]

  @@map("courier_providers")
}

// ─── Parcels ─────────────────────────────────────────────────────────────────

model Parcel {
  id             String         @id @default(uuid())
  trackingNumber String         @unique
  /// Opaque token encoded in the QR label. Never a database id, never personal data.
  qrToken        String         @unique
  title          String
  description    String
  categoryId     String
  category       ParcelCategory @relation(fields: [categoryId], references: [id])
  classification String
  priority       String
  status         String
  deliveryMethod String

  createdById        String
  createdBy          User        @relation("CreatedBy", fields: [createdById], references: [id])
  senderEmployeeId   String
  senderEmployee     Employee    @relation("SenderEmployee", fields: [senderEmployeeId], references: [id])
  senderDepartmentId String?
  senderDepartment   Department? @relation("SenderDepartment", fields: [senderDepartmentId], references: [id])
  originBranchId     String
  originBranch       Branch      @relation("OriginBranch", fields: [originBranchId], references: [id])
  originLocationId   String?
  originLocation     Location?   @relation("OriginLocation", fields: [originLocationId], references: [id])

  receiverType                 String
  receiverEmployeeId           String?
  receiverEmployee             Employee?   @relation("ReceiverEmployee", fields: [receiverEmployeeId], references: [id])
  receiverDepartmentId         String?
  receiverDepartment           Department? @relation("ReceiverDepartment", fields: [receiverDepartmentId], references: [id])
  externalReceiverName         String?
  externalReceiverPhone        String?
  externalReceiverOrganization String?
  externalReceiverAddress      String?
  destinationBranchId          String?
  destinationBranch            Branch?     @relation("DestinationBranch", fields: [destinationBranchId], references: [id])
  destinationLocationId        String?
  destinationLocation          Location?   @relation("DestinationLocation", fields: [destinationLocationId], references: [id])

  expectedDeliveryAt  DateTime?
  /// bcrypt hash of the sender's handover PIN. The PIN is shown to the sender once.
  handoverPinHash     String?
  /// Wrong PIN attempts. At the limit the PIN stops working and handover needs the sender's app or a dispatch officer.
  handoverPinFailures Int       @default(0)

  actualReceiverEmployeeId String?
  actualReceiverEmployee   Employee? @relation("ActualReceiverEmployee", fields: [actualReceiverEmployeeId], references: [id])
  actualReceiverName       String?
  actualReceiverCode       String?
  actualReceiverPhone      String?
  receivedOnBehalf         Boolean   @default(false)
  onBehalfReason           String?
  onBehalfRelationship     String?
  receiptVerification      String?

  // Milestones, denormalised from the ledger so the dashboard never has to scan events.
  bookedAt          DateTime?
  carrierAssignedAt DateTime?
  handedOverAt      DateTime?
  pickedUpAt        DateTime?
  inTransitAt       DateTime?
  arrivedAt         DateTime?
  pendingReceiptAt  DateTime?
  receivedAt        DateTime?
  cancelledAt       DateTime?
  returnRequestedAt DateTime?
  returnedAt        DateTime?
  statusChangedAt   DateTime  @default(now())
  /// Status to resume after ON_HOLD or DELIVERY_EXCEPTION is cleared.
  resumeStatus      String?

  isOverdue           Boolean            @default(false)
  overdueSince        DateTime?
  hasOpenException    Boolean            @default(false)
  currentAssignmentId String?            @unique
  currentAssignment   CarrierAssignment? @relation("CurrentAssignment", fields: [currentAssignmentId], references: [id])
  lastEventSequence   Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments            CarrierAssignment[]     @relation("ParcelAssignments")
  events                 ParcelEvent[]
  proofs                 ParcelProof[]
  attachments            ParcelAttachment[]
  comments               ParcelComment[]
  exceptions             ParcelException[]
  notifications          Notification[]
  escalations            Escalation[]
  externalProviderEvents ExternalProviderEvent[]

  @@index([status])
  @@index([senderEmployeeId])
  @@index([receiverEmployeeId])
  @@index([receiverDepartmentId])
  @@index([createdById])
  @@index([originBranchId, createdAt])
  @@index([destinationBranchId, createdAt])
  @@index([createdAt])
  @@index([isOverdue])
  @@index([priority])
  @@map("parcels")
}

/// Who is carrying the parcel. A reassignment ends one row and starts another.
model CarrierAssignment {
  id          String  @id @default(uuid())
  parcelId    String
  parcel      Parcel  @relation("ParcelAssignments", fields: [parcelId], references: [id])
  currentFor  Parcel? @relation("CurrentAssignment")
  carrierType String
  status      String

  employeeId     String?
  employee       Employee?     @relation(fields: [employeeId], references: [id])
  guestCarrierId String?
  guestCarrier   GuestCarrier? @relation(fields: [guestCarrierId], references: [id])

  courierProviderId          String?
  courierProvider            CourierProvider? @relation(fields: [courierProviderId], references: [id])
  externalTrackingNumber     String?
  externalBookingReference   String?
  riderName                  String?
  riderPhone                 String?
  pickupReference            String?
  trackingUrl                String?
  externalExpectedDeliveryAt DateTime?
  externalRawStatus          String?
  externalStatusAt           DateTime?

  carrierNameSnapshot  String
  carrierPhoneSnapshot String?
  carrierCodeSnapshot  String?

  assignedByUserId    String
  assignedBy          User      @relation("AssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt          DateTime  @default(now())
  acceptedAt          DateTime?
  handoverRequestedAt DateTime?
  custodyStartedAt    DateTime?
  endedAt             DateTime?
  endReason           String?
  notes               String?

  @@index([parcelId])
  @@index([employeeId, status])
  @@index([guestCarrierId, status])
  @@index([externalTrackingNumber])
  @@map("carrier_assignments")
}

/// The custody ledger. Append-only: corrections are new CORRECTION_ADDED rows.
model ParcelEvent {
  id                   String    @id @default(uuid())
  parcelId             String
  parcel               Parcel    @relation(fields: [parcelId], references: [id])
  sequence             Int
  eventType            String
  fromStatus           String?
  toStatus             String?
  actorType            String
  actorUserId          String?
  actorGuestId         String?
  actorNameSnapshot    String
  actorCodeSnapshot    String?
  locationId           String?
  location             Location? @relation(fields: [locationId], references: [id])
  locationNameSnapshot String?
  carrierAssignmentId  String?
  /// Authoritative. Clients never set this.
  serverTimestamp      DateTime  @default(now())
  /// What the phone's clock said; kept for offline sync forensics only.
  deviceTimestamp      DateTime?
  latitude             Float?
  longitude            Float?
  verificationMethod   String?
  proofId              String?
  notes                String?
  externalProvider     String?
  externalEventId      String?
  correctsEventId      String?
  metadata             Json      @default("{}")
  idempotencyKey       String?   @unique
  createdAt            DateTime  @default(now())

  @@unique([parcelId, sequence])
  @@index([parcelId, serverTimestamp])
  @@index([eventType, serverTimestamp])
  @@map("parcel_events")
}

model ParcelProof {
  id               String   @id @default(uuid())
  parcelId         String
  parcel           Parcel   @relation(fields: [parcelId], references: [id])
  type             String
  createdByUserId  String?
  createdByGuestId String?
  attachmentId     String?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())

  @@index([parcelId])
  @@map("parcel_proofs")
}

model ParcelAttachment {
  id                String   @id @default(uuid())
  parcelId          String
  parcel            Parcel   @relation(fields: [parcelId], references: [id])
  kind              String
  fileName          String
  mimeType          String
  sizeBytes         Int
  sha256            String
  /// Key inside private storage. Files are served only through authorised, short-lived links.
  storageKey        String   @unique
  uploadedByUserId  String?
  uploadedByGuestId String?
  uploadedByName    String
  createdAt         DateTime @default(now())

  @@index([parcelId])
  @@map("parcel_attachments")
}

model ParcelComment {
  id                 String   @id @default(uuid())
  parcelId           String
  parcel             Parcel   @relation(fields: [parcelId], references: [id])
  authorUserId       String?
  authorGuestId      String?
  authorNameSnapshot String
  body               String
  createdAt          DateTime @default(now())

  @@index([parcelId])
  @@map("parcel_comments")
}

model ParcelException {
  id               String    @id @default(uuid())
  parcelId         String
  parcel           Parcel    @relation(fields: [parcelId], references: [id])
  code             String
  details          String
  statusBefore     String
  raisedByUserId   String?
  raisedByGuestId  String?
  raisedByName     String
  raisedAt         DateTime  @default(now())
  resolvedByUserId String?
  resolvedByName   String?
  resolvedAt       DateTime?
  resolution       String?

  @@index([parcelId])
  @@index([resolvedAt])
  @@map("parcel_exceptions")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcelId  String?
  parcel    Parcel?   @relation(fields: [parcelId], references: [id])
  eventId   String?
  eventType String
  category  String
  title     String
  body      String
  /// Lock-screen safe: push payloads for sensitive notifications carry no parcel details.
  sensitive Boolean   @default(false)
  data      Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  /// One physical event never notifies the same person twice.
  dedupeKey String    @unique

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id                String   @id @default(uuid())
  notificationId    String?
  channel           String
  /// Masked recipient (token suffix or phone mask) — never the OTP or full number.
  target            String
  provider          String
  status            String
  providerMessageId String?
  error             String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@map("notification_deliveries")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  appVersion String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@map("device_tokens")
}

model NotificationPreference {
  id      String  @id @default(uuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel String
  enabled Boolean @default(true)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

// ─── SLA ─────────────────────────────────────────────────────────────────────

model SlaPolicy {
  id                  String   @id @default(uuid())
  name                String
  active              Boolean  @default(true)
  stage               String
  thresholdMinutes    Int
  audience            String[]
  marksOverdue        Boolean  @default(false)
  // Optional filters. Null = applies to all.
  priority            String?
  classification      String?
  categoryId          String?
  originBranchId      String?
  destinationBranchId String?
  deliveryMethod      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  escalations Escalation[]

  @@map("sla_policies")
}

model Escalation {
  id            String    @id @default(uuid())
  parcelId      String
  parcel        Parcel    @relation(fields: [parcelId], references: [id])
  slaPolicyId   String
  slaPolicy     SlaPolicy @relation(fields: [slaPolicyId], references: [id])
  stage         String
  audience      String[]
  notifiedCount Int       @default(0)
  triggeredAt   DateTime  @default(now())

  @@unique([parcelId, slaPolicyId])
  @@map("escalations")
}

// ─── Integrations ────────────────────────────────────────────────────────────

/// Raw courier-provider events. The unique key is the webhook replay guard.
model ExternalProviderEvent {
  id                String          @id @default(uuid())
  courierProviderId String
  courierProvider   CourierProvider @relation(fields: [courierProviderId], references: [id])
  externalEventId   String
  parcelId          String?
  parcel            Parcel?         @relation(fields: [parcelId], references: [id])
  assignmentId      String?
  trackingNumber    String?
  rawStatus         String?
  normalizedStatus  String?
  payload           Json
  outcome           String
  message           String?
  receivedAt        DateTime        @default(now())

  @@unique([courierProviderId, externalEventId])
  @@map("external_provider_events")
}

// ─── Platform ────────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  actorType    String
  actorUserId  String?
  actorGuestId String?
  actorName    String
  action       String
  objectType   String
  objectId     String
  summary      String
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  sessionId    String?
  createdAt    DateTime @default(now())

  @@index([objectType, objectId])
  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id             String    @id @default(uuid())
  /// Who sent it: "user:<id>" or "guest:<id>". Keys are only unique per actor.
  actorKey       String
  key            String
  method         String
  path           String
  requestHash    String
  status         String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@unique([actorKey, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

model TrackingSequence {
  branchCode String
  dayStamp   String
  lastValue  Int

  @@id([branchCode, dayStamp])
  @@map("tracking_sequences")
}

model OtpChallenge {
  id             String    @id @default(uuid())
  purpose        String
  phone          String
  /// sha256(code + pepper). The code itself is never stored or logged.
  codeHash       String
  parcelId       String?
  guestCarrierId String?
  employeeId     String?
  /// Who the code was sent to and why (e.g. an on-behalf receiver). Never the code.
  metadata       Json      @default("{}")
  expiresAt      DateTime
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  consumedAt     DateTime?
  requestIp      String?
  createdAt      DateTime  @default(now())

  @@index([phone, purpose, createdAt])
  @@index([parcelId, purpose])
  @@map("otp_challenges")
}

model SavedView {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("saved_views")
}

// ── Incident & facility issues ──────────────────────────────────────────────

/// An employee's report of a problem at an office, in one of four groups
/// (Safety & Industrial, Admin & Facility, Security, IT/Technical). Taken
/// through REPORTED → ACKNOWLEDGED → UNDER_INVESTIGATION → CLOSED by that
/// office's admins; a confidential report goes to head office only. Groups,
/// sub-categories, severities, stages and resolutions are text checked by
/// CHECK constraints, with the vocabulary in packages/shared.
model Incident {
  id                     String    @id @default(uuid())
  /// INC-YYMMDD-OFFICE-NNN
  referenceNumber        String    @unique
  title                  String
  description            String    @default("")
  /// SAFETY_INDUSTRIAL, ADMIN_FACILITY, SECURITY or IT_TECHNICAL — always the group of `category`.
  group                  String
  category               String
  severity               String    @default("MEDIUM")
  status                 String    @default("REPORTED")
  branchId               String
  branch                 Branch    @relation(fields: [branchId], references: [id])
  locationId             String?
  location               Location? @relation(fields: [locationId], references: [id])
  /// "3rd floor, beside the lift"
  locationDetail         String?
  /// Kept even for anonymous and confidential reports, only to send status
  /// updates back to the reporter. Never returned to a handler by the API.
  reporterUserId         String
  reporter               User      @relation("IncidentReporter", fields: [reporterUserId], references: [id])
  /// The reporter's name is hidden from everyone handling it; still routed to the office.
  anonymous              Boolean   @default(false)
  /// Head office only (never the office's own admins), reporter hidden. Always true for misconduct.
  confidential           Boolean   @default(false)
  /// How it was closed (RESOLVED, NO_ACTION_NEEDED, DUPLICATE, REFERRED); null while open.
  resolution             String?
  /// The latest note the admins left for the reporter.
  statusNote             String?
  statusChangedAt        DateTime  @default(now())
  /// When a handler first moved it on from Reported.
  acknowledgedAt         DateTime?
  /// When it first went Under Investigation.
  investigationStartedAt DateTime?
  /// When it was closed; cleared if it is reopened.
  closedAt               DateTime?
  lastHandledById        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  updates IncidentUpdate[]
  photos  IncidentPhoto[]

  @@index([branchId, status])
  @@index([status, createdAt])
  @@index([group, status])
  @@index([reporterUserId, createdAt])
  @@map("incidents")
}

/// The incident's history. Append-only (database trigger), like the custody ledger.
model IncidentUpdate {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type        String
  fromStatus  String?
  toStatus    String?
  /// Visible to the reporter.
  note        String?
  /// Null for an anonymous submission.
  actorUserId String?
  actorName   String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_updates")
}

model IncidentPhoto {
  id               String   @id @default(uuid())
  incidentId       String
  incident         Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  /// REPORT (the problem) or RESOLUTION (proof it was fixed)
  kind             String
  storageKey       String   @unique
  fileName         String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  @@index([incidentId])
  @@map("incident_photos")
}

// ─────────────────────────────────────────────────────────────────────────────
// ABG ONE modules: official tours, pool cars, visitors, licences, notices.
// Statuses are text checked by CHECK constraints (see the migrations), with the
// allowed values and transitions in packages/shared.
// ─────────────────────────────────────────────────────────────────────────────

/// Small key/value settings an administrator can change (e.g. the annual travel budget).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("app_settings")
}

// ── Official tour requests ──

model TourRequest {
  id               String    @id @default(uuid())
  /// ABG-TR-YYYY-NNN
  referenceNumber  String    @unique
  type             String
  purpose          String
  /// Short title, e.g. "Gastech 2026 conference".
  title            String
  description      String    @default("")
  destination      String
  country          String?
  startDate        DateTime  @db.Date
  endDate          DateTime  @db.Date
  transportMode    String
  travellerUserId  String
  traveller        User      @relation("TourTraveller", fields: [travellerUserId], references: [id])
  branchId         String
  branch           Branch    @relation(fields: [branchId], references: [id])
  departmentId     String?
  /// Names of colleagues travelling on the same request.
  coTravellers     Json      @default("[]")
  /// Taka, whole units.
  estimatedBudget  Int
  advanceRequested Int       @default(0)
  sanctionedBudget Int?
  passportNumber   String?
  passportExpiry   DateTime? @db.Date
  /// The head of department who must approve first.
  approverUserId   String
  approver         User      @relation("TourApprover", fields: [approverUserId], references: [id])
  status           String    @default("PENDING_HOD")
  statusNote       String?
  statusChangedAt  DateTime  @default(now())
  hodApprovedAt    DateTime?
  vettedAt         DateTime?
  sanctionedAt     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  rejectedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  updates TourUpdate[]

  @@index([status, startDate])
  @@index([travellerUserId, createdAt])
  @@index([approverUserId, status])
  @@index([branchId, status])
  @@map("tour_requests")
}

/// A tour's history. Append-only (database trigger).
model TourUpdate {
  id          String      @id @default(uuid())
  tourId      String
  tour        TourRequest @relation(fields: [tourId], references: [id])
  type        String
  fromStatus  String?
  toStatus    String?
  note        String?
  actorUserId String?
  actorName   String
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())

  @@index([tourId, createdAt])
  @@map("tour_updates")
}

// ── Pool cars and fleet ──

model Vehicle {
  id                 String           @id @default(uuid())
  /// "Dhaka Metro-GA 11-2345"
  registrationNumber String           @unique
  make               String
  model              String
  type               String
  seats              Int
  colour             String?
  fuelType           String?
  branchId           String
  branch             Branch           @relation(fields: [branchId], references: [id])
  status             String           @default("AVAILABLE")
  /// Why it is in maintenance or out of service ("AC compressor replacement at the Tejgaon workshop").
  statusNote         String?
  statusChangedAt    DateTime         @default(now())
  odometerKm         Int              @default(0)
  nextServiceAt      DateTime?        @db.Date
  fitnessExpiry      DateTime?        @db.Date
  insuranceExpiry    DateTime?        @db.Date
  notes              String?
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  requisitions       CarRequisition[]

  @@index([branchId, status])
  @@map("vehicles")
}

model Driver {
  id            String           @id @default(uuid())
  fullName      String
  phone         String
  licenseNumber String
  licenseExpiry DateTime?        @db.Date
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id])
  /// Set when the driver has an app account (role DRIVER).
  userId        String?          @unique
  user          User?            @relation("DriverAccount", fields: [userId], references: [id])
  employeeId    String?
  status        String           @default("AVAILABLE")
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  requisitions  CarRequisition[]

  @@index([branchId, status])
  @@map("drivers")
}

model CarRequisition {
  id                String    @id @default(uuid())
  /// PC-YYMMDD-OFFICE-NNN
  referenceNumber   String    @unique
  requesterUserId   String
  requester         User      @relation("CarRequester", fields: [requesterUserId], references: [id])
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id])
  departmentId      String?
  tripType          String
  purpose           String
  pickupLocation    String
  dropLocation      String
  pickupAt          DateTime
  returnAt          DateTime?
  /// [{ name, phone? }]
  passengers        Json      @default("[]")
  passengerCount    Int       @default(1)
  urgent            Boolean   @default(false)
  vehiclePreference String    @default("ANY")
  approverUserId    String
  approver          User      @relation("CarApprover", fields: [approverUserId], references: [id])
  status            String    @default("PENDING_HOD")
  statusNote        String?
  statusChangedAt   DateTime  @default(now())
  vehicleId         String?
  vehicle           Vehicle?  @relation(fields: [vehicleId], references: [id])
  driverId          String?
  driver            Driver?   @relation(fields: [driverId], references: [id])
  /// Opaque token behind the QR gate pass (/g/c/<token>).
  gatePassToken     String?   @unique
  hodApprovedAt     DateTime?
  assignedAt        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  startOdometerKm   Int?
  endOdometerKm     Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  updates CarRequisitionUpdate[]

  @@index([status, pickupAt])
  @@index([requesterUserId, createdAt])
  @@index([approverUserId, status])
  @@index([branchId, status])
  @@index([driverId, status])
  @@index([vehicleId, status])
  @@map("car_requisitions")
}

/// A requisition's history. Append-only (database trigger).
model CarRequisitionUpdate {
  id            String         @id @default(uuid())
  requisitionId String
  requisition   CarRequisition @relation(fields: [requisitionId], references: [id])
  type          String
  fromStatus    String?
  toStatus      String?
  note          String?
  actorUserId   String?
  actorName     String
  metadata      Json           @default("{}")
  createdAt     DateTime       @default(now())

  @@index([requisitionId, createdAt])
  @@map("car_requisition_updates")
}

// ── Visitors ──

model Visit {
  id             String    @id @default(uuid())
  /// VP-YYMMDD-OFFICE-NNN — the gate pass number.
  passNumber     String    @unique
  visitorName    String
  visitorPhone   String
  company        String?
  /// Last 4 digits only; never the full national ID.
  idLast4        String?
  purpose        String
  purposeDetail  String?
  partySize      Int       @default(1)
  vehicleNumber  String?
  carrying       String?
  branchId       String
  branch         Branch    @relation(fields: [branchId], references: [id])
  locationId     String?
  location       Location? @relation(fields: [locationId], references: [id])
  hostUserId     String?
  host           User?     @relation("VisitHost", fields: [hostUserId], references: [id])
  hostName       String
  expectedAt     DateTime
  expectedUntil  DateTime?
  status         String    @default("EXPECTED")
  walkIn         Boolean   @default(false)
  badgeNumber    String?
  /// Opaque token behind the QR gate pass (/g/v/<token>).
  passToken      String    @unique
  checkedInAt      DateTime?
  checkedInById    String?
  /// Name snapshot of the guard or desk officer who checked the visitor in.
  checkedInByName  String?
  /// Where the visitor was checked in: "Factory A › Security Gate".
  checkInPoint     String?
  checkedOutAt     DateTime?
  checkedOutById   String?
  checkedOutByName String?
  cancelledAt      DateTime?
  cancelledById    String?
  cancelledByName  String?
  cancelReason     String?
  /// When an unused pass lapsed at the end of its Dhaka day.
  expiredAt        DateTime?
  createdById      String
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([branchId, status])
  @@index([branchId, expectedAt])
  @@index([branchId, checkedInAt])
  @@index([status, expectedAt])
  @@index([hostUserId, expectedAt])
  @@index([visitorPhone])
  @@map("visits")
}

// ── Regulatory licences ──

model Licence {
  id               String    @id @default(uuid())
  name             String
  licenceNumber    String
  category         String
  issuingAuthority String
  branchId         String
  branch           Branch    @relation(fields: [branchId], references: [id])
  /// The person responsible for keeping it valid.
  ownerUserId      String?
  owner            User?     @relation("LicenceOwner", fields: [ownerUserId], references: [id])
  issuedAt         DateTime? @db.Date
  expiresAt        DateTime  @db.Date
  renewalLeadDays  Int       @default(90)
  renewalStage     String    @default("NOT_STARTED")
  renewalStartedAt DateTime?
  /// Taka, whole units.
  renewalFee       Int?
  documentKey      String?
  documentName     String?
  documentMime     String?
  documentSize     Int?
  /// The most recent alert threshold (days before expiry) already sent, per expiry date.
  lastAlertDays    Int?
  lastAlertAt      DateTime?
  notes            String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  events LicenceEvent[]

  @@unique([branchId, licenceNumber])
  @@index([expiresAt])
  @@index([branchId, expiresAt])
  @@map("licences")
}

/// A licence's history. Append-only (database trigger).
model LicenceEvent {
  id          String   @id @default(uuid())
  licenceId   String
  licence     Licence  @relation(fields: [licenceId], references: [id])
  type        String
  note        String?
  actorUserId String?
  actorName   String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([licenceId, createdAt])
  @@map("licence_events")
}

// ── Notice board ──

model Notice {
  id                      String    @id @default(uuid())
  /// ABG-NB-YYYY-NNN
  referenceNumber         String    @unique
  title                   String
  body                    String
  channel                 String
  category                String    @default("GENERAL")
  urgent                  Boolean   @default(false)
  pinned                  Boolean   @default(false)
  audience                String    @default("ALL")
  /// Office ids when audience = BRANCHES.
  branchIds               Json      @default("[]")
  requiresAcknowledgement Boolean   @default(true)
  status                  String    @default("DRAFT")
  authorUserId            String
  author                  User      @relation("NoticeAuthor", fields: [authorUserId], references: [id])
  /// Shown as the signatory, e.g. "Managing Director".
  signedBy                String?
  attachmentKey           String?
  attachmentName          String?
  attachmentMime          String?
  attachmentSize          Int?
  publishedAt             DateTime?
  expiresAt               DateTime?
  archivedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  receipts NoticeReceipt[]

  @@index([status, publishedAt])
  @@map("notices")
}

/// Who has opened and who has acknowledged a notice.
model NoticeReceipt {
  id             String    @id @default(uuid())
  noticeId       String
  notice         Notice    @relation(fields: [noticeId], references: [id])
  userId         String
  user           User      @relation("NoticeReader", fields: [userId], references: [id])
  readAt         DateTime  @default(now())
  acknowledgedAt DateTime?

  @@unique([noticeId, userId])
  @@index([userId])
  @@map("notice_receipts")
}
